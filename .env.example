# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

PORT=3000

# ── Live price feed (Deriv) ────────────────────────────────────────────────
# Optional. Both have working defaults (see server/derivFeed.js) — set these
# only if you need to point at a different endpoint or Deriv issues you an
# app_id. If the feed is unreachable, pairs quietly fall back to the
# built-in random-walk simulator, so trading/settlement never stalls.
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089

# Set to "1" only when running behind a reverse proxy/load balancer (Render,
# Heroku, Nginx, Cloudflare, ...) so rate limiting keys on the real client IP.
TRUST_PROXY=

# ── Admin seed accounts ─────────────────────────────────────────────────────
SUPERADMIN_USERNAME=root
SUPERADMIN_PASSWORD=change-me

# ── Paystack — card checkout + M-Pesa mobile money, one account ──────────
# Get keys at https://dashboard.paystack.com/#/settings/developer
# One Paystack account covers both payment methods below — there's no
# separate Safaricom Daraja app/paybill registration to do. Card
# number/CVV/expiry are entered inside Paystack's own hosted widget and
# never touch this server; M-Pesa deposits go through Paystack's Charge
# API, which sends the STK push to the customer's phone on our behalf. This
# server only ever verifies transaction results server-to-server. This
# account must be a Kenya (KES) account — card and M-Pesa deposits are both
# collected in KES (see MPESA_USD_KES_RATE below).

# Safe to expose to the browser — used to launch the Paystack card widget.
PAYSTACK_PUBLIC_KEY=

# Secret — never expose to the client. Used to call the Paystack API
# (initiate M-Pesa charges, verify transactions) and to verify webhook
# signatures. No separate webhook secret to configure — set your webhook
# URL to https://<your-domain>/api/paystack/webhook on the Paystack
# dashboard (Settings > API Keys & Webhooks); Paystack signs each webhook
# with this same secret key (x-paystack-signature header), which the server
# checks before trusting anything in the payload.
PAYSTACK_SECRET_KEY=

# Static USD/KES rate used to convert KES M-Pesa deposits into the
# platform's USD balances. Replace with a live FX feed before relying on
# this in real production — a static rate will drift from the market over
# time.
MPESA_USD_KES_RATE=129

# ── Where collected M-Pesa/card money actually ends up ────────────────────
# There is nothing to set here in .env for this — it's not a code-level
# setting. Paystack collects into its own account (STK pushes always come
# from Paystack's merchant channel, never a paybill/account you pass in
# code) and then *settles* the balance to whichever bank account is
# registered and KYC-verified on your Paystack dashboard:
#   Dashboard → Settings → Preferences → Bank Account
# Register your bank there (e.g. KCB, account 1340019779 — note: this is
# your own bank account number for settlement, not the M-Pesa Pay Bill
# 522522/account you'd use for a manual paybill deposit) so payouts land in
# it on Paystack's settlement schedule (typically T+1).
